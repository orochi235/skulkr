{
  "name": "skulkr-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Live dashboard of a project's skulkr audit rounds: areas, running lanes, rounds, jobs, and defects.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck.mjs",
    "serve": "vite build && vite preview",
    "build:demo": "vite build --config vite.demo.config.ts --mode demo",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@msb235/blits": "^1.7.0",
    "@weasel-js/animator": "2.0.0",
    "@weasel-js/core": "2.0.0",
    "@weasel-js/editing": "2.0.0",
    "@weasel-js/font": "2.0.0",
    "@weasel-js/geom": "2.0.0",
    "@weasel-js/gestures": "2.0.0",
    "@weasel-js/hud": "2.0.0",
    "@weasel-js/icons": "2.0.0",
    "@weasel-js/loupe": "2.0.0",
    "@weasel-js/prefs": "2.0.0",
    "@weasel-js/react": "2.0.0",
    "@weasel-js/registry": "2.0.0",
    "@weasel-js/routing": "2.0.0",
    "@weasel-js/scale": "2.0.0",
    "@weasel-js/storage": "2.0.0",
    "@weasel-js/svg": "2.0.0",
    "@weasel-js/theme": "2.0.0",
    "@weasel-js/ui": "2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@msb235/alpo": "^0.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "vite-plugin-wake": "file:../../wake"
  }
}
