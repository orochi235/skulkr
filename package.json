{
  "name": "skulkr",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Nightly blind-pair audit rounds over any git repository, driven by a config file in that repository.",
  "bin": {
    "skulkr": "bin/skulkr.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:all": "vitest run && npm --prefix dashboard test",
    "typecheck": "tsc --noEmit",
    "menubar:install": "mkdir -p ~/.local/bin && ln -sf \"$PWD/bin/skulkr.mjs\" ~/.local/bin/skulkr && cd menubar && ${PERCH:-perch} install",
    "menubar:uninstall": "cd menubar && ${PERCH:-perch} uninstall"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
